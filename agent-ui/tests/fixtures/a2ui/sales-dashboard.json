{
  "format": "a2ui",
  "version": "1.0",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "main",
        "catalogId": "https://priva.app/a2ui/catalog/v1",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "heading",
              "metrics",
              "regional",
              "actions"
            ],
            "gap": "large"
          },
          {
            "id": "heading",
            "component": "Heading",
            "text": "Q3 Sales Performance",
            "subtitle": "Quarterly performance across regional territories and product categories",
            "eyebrow": "Global Commercial Operations"
          },
          {
            "id": "metrics",
            "component": "Grid",
            "children": [
              "revenue",
              "attainment",
              "growth",
              "region"
            ],
            "columns": 4
          },
          {
            "id": "revenue",
            "component": "Stat",
            "label": "Total Revenue",
            "value": "$14.8M",
            "delta": "+8.2%",
            "caption": "vs $13.7M target",
            "trend": "up"
          },
          {
            "id": "attainment",
            "component": "Stat",
            "label": "Target Attainment",
            "value": "108%",
            "delta": "+4.5%",
            "caption": "100% baseline",
            "trend": "up"
          },
          {
            "id": "growth",
            "component": "Stat",
            "label": "YoY Growth",
            "value": "14.2%",
            "delta": "+2.1%",
            "caption": "vs Q3 prior year",
            "trend": "up"
          },
          {
            "id": "region",
            "component": "Stat",
            "label": "Top Region",
            "value": "North America",
            "caption": "41% of quarterly total"
          },
          {
            "id": "regional",
            "component": "BarChart",
            "title": "Regional Performance vs Target",
            "labels": [
              "North America",
              "Europe",
              "Asia Pacific",
              "Latin America"
            ],
            "series": [
              {
                "name": "Actual",
                "values": [
                  6.1,
                  4.3,
                  3.2,
                  1.2
                ]
              },
              {
                "name": "Target",
                "values": [
                  5.6,
                  4.2,
                  2.8,
                  1.1
                ]
              }
            ],
            "description": "Actual revenue compared against regional Q3 quotas",
            "format": "currency",
            "unit": "M"
          },
          {
            "id": "actions",
            "component": "Row",
            "children": [
              "explore",
              "compare"
            ]
          },
          {
            "id": "explore",
            "component": "Button",
            "label": "Explore North America",
            "action": {
              "event": {
                "name": "explore_region",
                "context": {
                  "region": "North America",
                  "quarter": "Q3"
                },
                "userMessage": "Explore North America"
              }
            }
          },
          {
            "id": "compare",
            "component": "Button",
            "label": "Compare with Q2",
            "action": {
              "event": {
                "name": "compare_quarters",
                "context": {
                  "quarters": [
                    "Q2",
                    "Q3"
                  ]
                },
                "userMessage": "Compare with Q2"
              }
            },
            "variant": "outline"
          }
        ]
      }
    }
  ]
}
