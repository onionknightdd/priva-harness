# Only source, tests and build inputs are allowed into the image context.
*
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json
!eslint.config.js
!vitest.config.mjs
!docker-entrypoint.sh
!docker/
!docker/**
!src/
!src/**
!tests/
!tests/**
!scripts/
!scripts/**
# Plugin runtimes copied for local development stay out of the context; the image installs its own.
src/resources/plugins/*/mcp/runtime
**/.env*
**/*.local
**/*.pem
**/*.key
**/node_modules
**/.DS_Store
