{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness shared session stream v3 (design draft)",
  "description": "Shared Chat WS and full HTTP SSE frames. A2A task streaming uses a separate standard projection. All examples are synthetic.",
