    {
      "$ref": "#/$defs/EventFrame"
    },
    {
      "$ref": "#/$defs/SnapshotFrame"
    },
    {
      "$ref": "#/$defs/ReplyFrame"
    },
    {
      "$ref": "#/$defs/ControlFrame"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "Sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "JsonValue": {},
    "StreamError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
