                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "basis": {
              "const": "native_reported"
            }
          },
          "required": [
            "startedAt",
            "endedAt",
            "durationMs",
            "basis"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "startedAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endedAt": {
              "type": "null"
            },
            "durationMs": {
              "type": "null"
            },
            "basis": {
              "const": "host_observed"
            }
          },
          "required": [
            "startedAt",
            "endedAt",
            "durationMs",
            "basis"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "startedAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endedAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "basis": {
              "const": "host_observed"
            }
          },
          "required": [
            "startedAt",
            "endedAt",
            "durationMs",
            "basis"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
